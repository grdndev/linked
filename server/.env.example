PORT=3001
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:3001
APP_RETURN_URL=liked://mes-achats
WEB_ORIGIN=http://localhost:8081
DATABASE_PATH=./data/liked.sqlite
UPLOAD_DIR=./data/uploads
# Generate with: openssl rand -hex 32. Never use EXPO_PUBLIC_ for secrets.
AUTH_SECRET=
# Test keys only until the marketplace has passed acceptance testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BREVO_API_KEY=
# Use an authenticated sender in your Brevo account.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Liked

# Simulated parcel lifecycle only. No postage or real carrier request.
SHIPPING_DRIVER=simulated
# Optional private beta: only these comma-separated email addresses may log in.
BETA_ALLOWED_EMAILS=
# Optional ready Stripe TEST Connect account for the dedicated fictional seller.
# Enables private test scenarios only for BETA_ALLOWED_EMAILS.
BETA_SELLER_STRIPE_ID=
